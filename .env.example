# Lensly.care Environment Configuration Template
# Copy this file to .env and configure appropriate values for your environment.

# Node Environment
NODE_ENV=development

# Database (PostgreSQL)
# Optional in development (falls back to local private JSON storage)
DATABASE_URL=postgresql://lensly_user:lensly_pass@localhost:5432/lensly_db

# Admin Security (Argon2id)
# Generate with: bun -e "import { hash, Algorithm } from '@node-rs/argon2'; console.log(await hash('YOUR_ADMIN_PASSWORD', { memoryCost: 65536, timeCost: 3, parallelism: 4, algorithm: Algorithm.Argon2id }));"
ADMIN_PASSWORD_HASH=

# Admin Session Secret (Minimum 32 random characters / 64 hex characters)
# Generate with: bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Private File Storage
# In development, files are stored on disk in STORAGE_DIR outside public root.
STORAGE_DIR=./storage/private

# Production Private Object Storage (S3 / Cloudflare R2 / MinIO)
# Optional in development. Required for cloud production deployments.
# S3_BUCKET=lensly-private-documents
# S3_REGION=eu-central-1
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
